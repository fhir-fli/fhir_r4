  "http://hl7.org/fhir/cda/mapping/ClinicalDocumentToFHIR"],
  "group" : [{
    "name" : "CCDADocument",
    "input" : [{
      "name" : "source",
      "type" : "ClinicalDocument",
      "mode" : "source"
    }],
    "rule" : [{
      "name" : "start",
      "source" : [{
        "context" : "source"
      }],
      "target" : [{
        "contextType" : "variable",
        "variable" : "target",
        "transform" : "create",
        "parameter" : [{
          "valueString" : "Bundle"
        }]
      }],
      "dependent" : [{
        "name" : "ClinicalDocumentBundle",
        "variable" : ["source",
        "target"]
      }]
    }]
  },
  {
    "name" : "CCDASections",
