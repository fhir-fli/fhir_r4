    }],
    "rule" : [{
      "name" : "allergySection",
      "source" : [{
        "context" : "component",
        "element" : "section",
        "variable" : "srcSection",
        "condition" : "code.code = '48765-2'"
      }],
      "target" : [{
        "context" : "target",
