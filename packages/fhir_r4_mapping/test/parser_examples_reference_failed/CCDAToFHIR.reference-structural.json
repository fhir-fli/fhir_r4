        "condition" : "code.code != '48765-2'"
      }],
      "target" : [{
        "context" : "target",
        "contextType" : "variable",
        "element" : "section",
        "variable" : "tgtSection"
      }],
      "dependent" : [{
        "name" : "ClinicalDocumentSection",
        "variable" : ["srcSection",
        "patient",
        "tgtSection"]
      }]
    }]
  }]
